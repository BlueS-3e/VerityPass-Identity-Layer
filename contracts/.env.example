## Example env for contracts deployment
# Copy to `contracts/.env` and fill values before deploying

# Private key of the deployer (DO NOT COMMIT real keys)
DEPLOYER_PRIVATE_KEY="28969ca6ae22e8752a7f2f087b7b0a3cd5da37b83eb2d5bc736a8342747e737e"

# RPC endpoint for the target network. For BSC: a BSC RPC or use generic RPC_URL
RPC_URL="https://bsc-dataseed.binance.org/"

# Optionally override the price feed address used by RealMintLaunchpad constructor
# If you deploy to Sepolia, Chainlink ETH/USD feed is at 0x694AA1769357215DE4FAC081bf1f309aDC325306.
PRICE_FEED_ADDRESS=""

# Verification API key (Etherscan / BscScan) for automatic verification step
BSCSCAN_API_KEY=""
ETHERSCAN_API_KEY="Q88526YXW3VT8K3WJAIYDWX1FHMKYW236H"

# Ethereum-specific RPCs (optional, set for mainnet / sepolia)
MAINNET_RPC_URL=""
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/uX0iy1guxpRYYKAPixrXO"
# Infura / Alchemy keys (optional shorthand)
INFURA_API_KEY=""
ALCHEMY_API_KEY="https://eth-sepolia.g.alchemy.com/v2/uX0iy1guxpRYYKAPixrXO"

# Optional: multisig or admin address to transfer ownership to after deploy
MULTISIG_ADDRESS=""
