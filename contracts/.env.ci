# CI / Production env example (DO NOT store secrets in plaintext in repo)
# Use your CI provider's secret store to set these values (GitHub Actions Secrets, GitLab CI variables, etc.).

# RPC provider URL (set to your provider's node for the target network)
RPC_URL=${{ secrets.RPC_URL }}

# Private key for deployer account (use a secure key or multisig/owner)
PRIVATE_KEY=${{ secrets.DEPLOYER_PRIVATE_KEY }}

# Etherscan / Block explorer API key
ETHERSCAN_API_KEY=${{ secrets.ETHERSCAN_API_KEY }}

# Network selection (optional)
HARDHAT_NETWORK=sepolia

# Example GitHub Actions usage (snippet):
# - name: Deploy contracts
#   env:
#     RPC_URL: ${{ secrets.RPC_URL }}
#     PRIVATE_KEY: ${{ secrets.DEPLOYER_PRIVATE_KEY }}
#     ETHERSCAN_API_KEY: ${{ secrets.ETHERSCAN_API_KEY }}
#   run: |
#     npx hardhat run --network sepolia scripts/deploy.js

# Notes:
# - Do not commit real secrets. Use CI secrets or a secret manager.
# - If using GitHub Actions, define the named secrets in repository Settings -> Secrets.
