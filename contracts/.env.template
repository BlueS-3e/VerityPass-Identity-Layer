# Contracts / Hardhat environment template
# Use a secure secret store (do not place real private keys in plaintext in the repo)

# RPC providers
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_PROJECT_ID=your_infura_project_id

# Private key of the deployer (recommended: use a multisig / Gnosis Safe)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY  # keep in secret manager

# Etherscan / Polygonscan keys for verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Network endpoints (optional)
MAINNET_RPC=https://eth-mainnet.alchemyapi.io/v2/your_key
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/your_key

# Hardhat options
HARDHAT_NETWORK=sepolia

# Note: Rotate keys if ever exposed. Use CI secrets for deploys (GitHub Secrets, GitLab CI variables, etc.).
