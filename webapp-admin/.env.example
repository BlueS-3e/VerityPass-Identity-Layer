# Example Vite envs for webapp-admin (do NOT commit real secrets)
# These are used at build time when you build the admin UI.
# If you don't set them, the admin app will attempt to read runtime values from
# the server's `/api/frontend-config` endpoint when loaded same-origin.

# URL where the API is reachable from the browser (include protocol, no trailing slash)
VITE_API_BASE=https://api.example.com

# Hostname where the admin UI is served. The public dApp will redirect to this host
# when a user hits /admin. Use a full origin (https://admin.example.com) or a host.
VITE_ADMIN_HOST=https://admin.example.com

# Optional: default chain id to show in admin UI
VITE_DEFAULT_CHAIN_ID=1
