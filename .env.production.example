# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to your hosting provider's environment settings
# Do NOT commit actual values to git
# =============================================================================

# ============= BNB CHAIN MAINNET =============
# BNB Chain mainnet RPC endpoint
VITE_RPC_URL_MAINNET=https://bsc-dataseed.binance.org
MAINNET_RPC_URL=https://bsc-dataseed.binance.org
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Deployed contract addresses on mainnet
VITE_LAUNCHPAD_ADDRESS=0x...  # RealMintLaunchpad mainnet address
LAUNCHPAD_ADDRESS=0x...       # Same address for API

# Network config (BNB Chain mainnet)
VITE_NETWORK=mainnet
VITE_CHAIN_ID=56

# ============= BNB CHAIN TESTNET (optional, for staging) =============
VITE_RPC_URL_BSC_TESTNET=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
VITE_CHAIN_ID_TESTNET=97

# ============= API & BACKEND =============
# API endpoint for webapp
VITE_API_BASE=https://api.yourdomain.com

# Flask/API configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-very-long-random-secret-key-here-min-32-chars

# Session settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=604800

# CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ============= DATABASE & CACHE =============
# PostgreSQL connection (Render provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/realmint_prod

# Redis for sessions and caching
REDIS_URL=redis://user:password@host:6379

# ============= BLOCKCHAIN INTEGRATION =============
# Price feed address (set BNB-compatible feed for your deployment)
PRICE_FEED_ADDRESS=0x0000000000000000000000000000000000000000

# BscScan API for contract verification
BSCSCAN_API_KEY=your-bscscan-api-key

# ============= PLAID INTEGRATION =============
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENVIRONMENT=production

# ============= MONITORING & ANALYTICS =============
# Sentry error tracking
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project

# Prometheus and logging
LOG_LEVEL=INFO
PROMETHEUS_MULTIPROC_DIR=/tmp

# ============= OPTIONAL: ANALYTICS =============
VITE_ANALYTICS_KEY=your-analytics-key

# ============= OPTIONAL: MULTISIG =============
# For ownership/admin functions on contract
MULTISIG_ADDRESS=0x...  # Your production multisig address
