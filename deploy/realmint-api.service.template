[Unit]
Description=RealMint Launchpad API
After=network.target

[Service]
User=realmint
Group=realmint
WorkingDirectory=/srv/realmint
# Prefer using an EnvironmentFile for production to keep secrets out of unit files.
# Create a file like /etc/realmint/realmint-api.env with restricted permissions (0600)
# and reference it here via the EnvironmentFile directive. Example content:
# SECRET_KEY=...\n# PUBLIC_API_BASE=...\n# REDIS_URL=redis://:password@redis:6379/0
EnvironmentFile=/etc/realmint/realmint-api.env
Environment="ENABLE_PROXY_FIX=true"
ExecStart=/srv/realmint/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 "app:app"
Restart=on-failure

[Install]
WantedBy=multi-user.target
