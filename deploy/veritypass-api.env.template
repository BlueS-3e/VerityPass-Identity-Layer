## Template for /etc/veritypass/veritypass-api.env
# Copy this file to /etc/veritypass/veritypass-api.env on the host and fill with production values.
# The file should contain simple KEY=VALUE lines (no export), one per line.
# Example:
# SECRET_KEY=replace-with-long-random-secret
# REDIS_URL=redis://:password@redis.example:6379/0

# Flask / app
SECRET_KEY=
PUBLIC_API_BASE=
ALLOWED_ORIGINS=

# Admin / auth
ADMIN_PASSWORD=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_ADMIN_ALLOWLIST=
DISABLE_PASSWORD_LOGIN=

# Database & cache
DATABASE_URL=
REDIS_URL=

# Session / cookies
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=604800

# Proxy / reverse proxy (if behind nginx/load balancer)
ENABLE_PROXY_FIX=false
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_REQUESTS=100
RATELIMIT_WINDOW_SIZE=3600

# Attestation pinning
NFT_STORAGE_API_KEY=

# Plaid (optional)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_ENCRYPTION_KEY=

# Error tracking (optional)
SENTRY_DSN=

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
FLASK_ENV=production
LOG_LEVEL=INFO
