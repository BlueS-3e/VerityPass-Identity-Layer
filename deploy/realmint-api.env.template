## Template for /etc/realmint/realmint-api.env
# Copy this file to /etc/realmint/realmint-api.env on the host and fill with production values.
# The file should contain simple KEY=VALUE lines (no export), one per line.
# Example:
# SECRET_KEY=replace-with-long-random-secret
# REDIS_URL=redis://:password@redis.example:6379/0

# Flask / app
SECRET_KEY=
PUBLIC_API_BASE=
ALLOWED_ORIGINS=

# Admin / auth
ADMIN_PASSWORD=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=

# NFT storage / external APIs
NFT_STORAGE_API_KEY=

# Redis (optional but recommended for production sessions)
REDIS_URL=

# Monitoring / error reporting
SENTRY_DSN=

# Feature flags / ops
ENABLE_LAUNCHPAD=true
DISABLE_PASSWORD_LOGIN=false

# NOTE: keep this file owned by root and readable only by the service user or root.
#       Recommended permissions: 0600 (rw-------) and owner root:root.
