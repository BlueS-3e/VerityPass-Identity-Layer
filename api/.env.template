# RealMint API environment template
# Copy this file to `.env` and fill in real values for local/staging/production.

# --- Database ---
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<db>

# --- Flask / Sessions ---
SECRET_KEY=replace_with_secure_random_string
JWT_SECRET=replace_with_jwt_secret

# --- Redis ---
REDIS_URL=redis://:<password>@<host>:6379/0

# --- Plaid (use sandbox for testing) ---
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# --- Blockchain / RPC Providers ---
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_PROJECT_ID=your_infura_project_id
RPC_FALLBACK_URLS="https://mainnet.infura.io/v3/<id>,https://rpc.alchemyapi.io/v2/<key>"
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY  # keep in secret store, do NOT commit

# --- Etherscan (for verification) ---
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- Wallet / WalletConnect ---
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# --- Storage ---
S3_BUCKET=your_s3_bucket
S3_REGION=your_s3_region
S3_KEY=your_s3_key
S3_SECRET=your_s3_secret

# --- Monitoring / Error Reporting ---
SENTRY_DSN=

# --- Third-party services (examples) ---
STRIPE_API_KEY=your_stripe_api_key
TRANSAK_API_KEY=your_transak_api_key

# --- Optional: feature flags / env ---
FLASK_ENV=production

# Note: Do NOT commit real secrets. Use your secret manager / CI secrets for production deployments.
