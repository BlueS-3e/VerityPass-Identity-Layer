# CI / Production env example for `api` (DO NOT store secrets in plaintext in repo)
# Use your CI provider's secret store to set these values (GitHub Actions Secrets, GitLab CI variables, etc.).

SECRET_KEY=${{ secrets.SECRET_KEY }}
DATABASE_URL=${{ secrets.DATABASE_URL }}
REDIS_URL=${{ secrets.REDIS_URL }}

CONTRACT_REALMINT_LAUNCHPAD=${{ secrets.CONTRACT_REALMINT_LAUNCHPAD }}
AAVE_POOL_ADDRESS=${{ secrets.AAVE_POOL_ADDRESS }}
AAVE_PRICE_ORACLE=${{ secrets.AAVE_PRICE_ORACLE }}

SENTRY_DSN=${{ secrets.SENTRY_DSN }}

