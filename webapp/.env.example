# Local/dev environment for the web UI
# Backend API base URL used by the frontend when making requests
VITE_API_BASE=http://localhost:5000

# Admin host where the dedicated admin frontend is served.
# The admin frontend is a separate app (`webapp-admin`). See `webapp-admin/.env.example`
# for admin-specific environment variables and local dev settings.

# Optional: default chain id used at build time
# VITE_DEFAULT_CHAIN_ID=97
