# CI / Vercel / Netlify env example for `webapp` (client vars)
# Use hosting provider's env var UI or CI secrets.

VITE_API_BASE=${{ secrets.VITE_API_BASE }}
VITE_FEATURE_WALLETLESS=${{ secrets.VITE_FEATURE_WALLETLESS }}
VITE_SENTRY_DSN=${{ secrets.VITE_SENTRY_DSN }}
VITE_ANALYTICS_KEY=${{ secrets.VITE_ANALYTICS_KEY }}

# Notes:
# - Client-facing vars (VITE_*) will be embedded into the built bundle.
# - Do NOT set server-side secrets here; use `api` envs instead.
