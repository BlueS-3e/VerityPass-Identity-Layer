# RealMint Webapp environment template
# Copy to `.env.local` or set env vars in your hosting provider

# Frontend runtime API base (do not include credentials here)
VITE_API_BASE=https://api.yourdomain.com

# WalletConnect / wallet SDK IDs
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Feature flags (example)
VITE_ENABLE_MAGIC=false

# Optional public-only keys (okay to expose if truly public)
VITE_PUBLIC_MAP_KEY=your_public_map_key

# Optional Aave demo addresses: set these if you want the Aave demo to work
# The frontend will also read these at runtime from the backend `/api/frontend-config`
# so operators can change them without rebuilding the Vite bundle.
VITE_AAVE_POOL_ADDRESS=
VITE_AAVE_PRICE_ORACLE=

# Note: Never put private keys or server secrets in frontend env files. Keep secrets in the backend or CI secret store.
