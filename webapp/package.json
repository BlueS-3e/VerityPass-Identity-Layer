{
  "name": "realmint-launchpad",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "dev:raw": "vite",
    "start": "vite",
    "prebuild": "mkdir -p build/contracts && cp -r ../contracts/artifacts/contracts/RealMintLaunchpad.sol/RealMintLaunchpad.json build/contracts/ || true",
    "build": "vite build",
    "build:headless": "QT_QPA_PLATFORM=offscreen vite build || xvfb-run -s \"-screen 0 1280x1024x24\" vite build",
    "build:docker": "docker build -f Dockerfile.build -t realmint-webapp-build . && docker create --name tmp-build realmint-webapp-build && docker cp tmp-build:/app/dist ./dist || true && docker rm -f tmp-build || true",
    "clean-install": "rm -rf node_modules && npm install --no-audit --no-fund --legacy-peer-deps && npm run build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@walletconnect/web3-provider": "^1.8.0",
    "buffer": "^6.0.3",
    "date-fns": "^3.6.0",
    "ethers": "^6.9.0",
    "multiformats": "^13.0.0",
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "vite": "^7.1.1",
    "vitest": "^4.0.8"
  }
}
