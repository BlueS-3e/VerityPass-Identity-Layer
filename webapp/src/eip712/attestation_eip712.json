      { "name": "expiresAt", "type": "uint256" }
    ]
  },
  "primaryType": "Attestation",
  "notes": "Fill domain.chainId and domain.verifyingContract at runtime. Compute dataCIDHash as ethers.keccak256(ethers.toUtf8Bytes(dataCID))."
