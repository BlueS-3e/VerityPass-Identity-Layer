# Production Environment Variables for Vercel
# Copy to Vercel dashboard → Settings → Environment Variables

# Backend API URL (your Render API)
VITE_API_BASE="https://realmint-platform.onrender.com"

# WalletConnect Project ID (get free from https://cloud.walletconnect.com)
# Required for QR code modal to display properly
VITE_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"

# Smart contract address for RealMint Launchpad
VITE_CONTRACT_ADDRESS="0x..."

# Payment recipient address
VITE_PAYMENT_ADDRESS="0x..."

# Mainnet chain ID (56 = BNB Chain mainnet)
VITE_DEFAULT_CHAIN_ID="56"

# RPC URL for the selected chain
VITE_RPC_URL="https://bsc-dataseed.binance.org"

# Optional: Sentry error tracking (DSN from https://sentry.io)
VITE_SENTRY_DSN=""

# Optional: Feature flags
VITE_FEATURE_WALLETLESS="false"
